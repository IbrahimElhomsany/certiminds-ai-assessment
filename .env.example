# Copy to .env and fill in. .env is git-ignored; never commit real keys.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_TIMEOUT_S=30
RATE_LIMIT_PER_MIN=20
RAG_DENSE=1
# SIMULATE_FLAKY=1   # B3 demo: inject random timeouts / 429 / 500 / invalid JSON into the primary provider

# --- Nova Studio admin ---
JWT_SECRET=              # long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
# DATABASE_URL=sqlite:///data/nova_studio.db   # default; a postgresql:// URL works too
# ADMIN_LLM_MODEL=claude-haiku-5-5            # optional: cheaper model for Ask your data + follow-up drafts (default = LLM_MODEL)
# DEMO_PASSWORD=NovaDemo2026!                  # password for the demo staff accounts the seed creates

# --- Online card payment (Tap Payments) ---
# TAP_SECRET_KEY=        # from the Tap dashboard: Account > Operators. Use the sk_test_... key until you go live.
#                        # Leave empty and checkout simply offers "Pay on delivery".

# --- AI room makeover (/makeover): OpenAI's image model re-draws a room photo with our tiles ---
# OPENAI_API_KEY=        # from platform.openai.com > API keys. Empty = the page says makeovers are not switched on.
# OPENAI_DAILY_IMAGES=60 # cost guard: makeovers per day for the whole site (about $0.05 each at medium quality)
# OPENAI_IMAGE_MODEL=    # optional; default tries gpt-image-2, then gpt-image-1.5
