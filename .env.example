# Copy to .env and fill in. .env is git-ignored; never commit real keys.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_TIMEOUT_S=30
RATE_LIMIT_PER_MIN=20
RAG_DENSE=1
# SIMULATE_FLAKY=1   # B3 demo: inject random timeouts / 429 / 500 / invalid JSON into the primary provider

# --- Nova Studio admin ---
JWT_SECRET=              # long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
# DATABASE_URL=sqlite:///data/nova_studio.db   # default; a postgresql:// URL works too
# DEMO_PASSWORD=NovaDemo2026!                  # password for the demo staff accounts the seed creates
